# Salin menjadi .env. Anda hanya perlu mengganti KEY atau URL di bawah.
# Jangan kirim isi file .env ke chat dan jangan commit file tersebut.

# KEY: Cloudflare API token dengan Hyperdrive Write, Pages Write,
# Workers Scripts Write, Workers Routes Write, dan Zone Read.
CLOUDFLARE_API_TOKEN=masukkan-key-cloudflare

# URL: dashboard account, format https://dash.cloudflare.com/<ACCOUNT_ID>
CLOUDFLARE_ACCOUNT_URL=https://dash.cloudflare.com/masukkan-account-id

# URL: Supabase Direct connection dari tombol Connect (port 5432).
SUPABASE_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# URL: domain HTTPS preview. Jika akun belum memiliki zone aktif, setup akan
# otomatis memakai domain gratis workers.dev dan mengabaikan hostname ini.
SPI_APP_URL=https://spi-preview.example.com

# URL identitas admin pertama. Gunakan format mailto:nama@domain.tld.
SPI_ADMIN_EMAIL_URL=mailto:admin@example.com
