# Optional real Cloudflare Access values. The committed wrangler local config
# instead uses a synthetic localhost-only identity with the local demo seed.
ACCESS_ISSUER=https://your-team.cloudflareaccess.com
ACCESS_AUDIENCE=your-application-audience
ORGANIZATION_ID=your-provisioned-organization-id
APP_ORIGIN=http://localhost:5173

# Remote operations use separate values for each environment. Keep these in
# environment-scoped CI secrets/variables, never in committed files.
SPI_ENVIRONMENT=preview
SPI_D1_DATABASE_ID=11111111-1111-4111-8111-111111111111
SPI_OTHER_D1_DATABASE_ID=22222222-2222-4222-8222-222222222222
SPI_D1_DATABASE_NAME=spi-preview
SPI_APP_ORIGIN=https://preview.example.invalid
SPI_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
SPI_ACCESS_AUDIENCE=your-application-audience
SPI_ORGANIZATION_ID=org-preview
SPI_WORKER_ROUTE=preview.example.invalid/api/*
SPI_TELEGRAM_WEBHOOK_ROUTE=preview.example.invalid/telegram/webhook
SPI_ZONE_NAME=example.invalid
SPI_PAGES_PROJECT=spi-preview
SPI_AUTH_RATE_LIMIT_NAMESPACE_ID=2001
SPI_MUTATION_RATE_LIMIT_NAMESPACE_ID=2002
SPI_OTHER_AUTH_RATE_LIMIT_NAMESPACE_ID=3001
SPI_OTHER_MUTATION_RATE_LIMIT_NAMESPACE_ID=3002
SPI_TELEGRAM_DELIVERY_ENABLED=false

# Telegram preview values belong in an environment-scoped secret store.
# Never commit or paste their values into source, logs, screenshots, or chat.
TELEGRAM_BOT_TOKEN=set-in-secret-store
TELEGRAM_WEBHOOK_SECRET=set-in-secret-store
SPI_TELEGRAM_WEBHOOK_URL=https://preview.example.invalid/telegram/webhook
